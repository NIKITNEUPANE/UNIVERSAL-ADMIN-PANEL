# Universal Commerce OS - Environment Variables
# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_DB_PASSWORD=your-db-password-here

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Default Demo Tenant Settings
NEXT_PUBLIC_DEFAULT_STORE_SLUG=universal-demo-store

# Cloudflare R2 Object Storage Configuration
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name
R2_ENDPOINT=https://<your-account-id>.r2.cloudflarestorage.com
NEXT_PUBLIC_R2_PUBLIC_DOMAIN=https://your-custom-r2-domain.com
CF_API_TOKEN=your-cloudflare-api-token
